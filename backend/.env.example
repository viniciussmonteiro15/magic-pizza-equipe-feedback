# Copie para .env e preencha. Nunca versione o .env.
PORT=3001

# Endereço(s) do frontend permitidos (separados por vírgula).
CORS_ORIGIN=http://localhost:5173

# Arquivo do banco SQLite (use :memory: para testes descartáveis).
DB_FILE=./data/magic-pizza.db

# Segredos: gere valores longos e aleatórios, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# RG_PEPPER: mudar este valor invalida todos os logins por RG já cadastrados.
RG_PEPPER=
# TOKEN_SECRET: mudar este valor desconecta todo mundo (não perde dados).
TOKEN_SECRET=

# Código de acesso da aba Gestão. Vazio = acesso de gestor desativado.
MANAGER_PASSWORD=

# Tentativas de login por IP a cada 15 minutos.
LOGIN_MAX_ATTEMPTS=10

# Cadastros e feedbacks (públicos) aceitos por IP a cada 15 minutos.
WRITE_MAX_REQUESTS=30

# Defina como 1 se o servidor ficar atrás de um proxy (Nginx, Render, Railway...),
# para o limite de tentativas enxergar o IP real do visitante.
TRUST_PROXY=0
